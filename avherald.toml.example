# Copy to avherald.toml in the project directory.
# CLI flags override these values.

limit = 50
delay = 3
# database = "data/avherald.sqlite"

# List order: "update" or "occurrence"
sort = "update"

# Empty / omitted = every category. Names: crash, accident, incident, news, report
# categories = ["incident", "accident"]

# Stop after this many list pages (omit for no page cap)
# max_pages = 3

# proxy = "http://127.0.0.1:8080"
# timeout = 20
verbose = false
dry_run = false
# Continue from the last saved list page. Set fresh = true to start over.
resume = true
fresh = false
