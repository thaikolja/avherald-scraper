# Copy to .env and uncomment what you want to change.
# Precedence: CLI flags > this file > avherald.toml > built-in defaults.

# --- site ---
BASE_URL="https://avherald.com"

# --- storage ---
DATABASE_PATH="./data/avherald.sqlite"

# --- how many ---
AVHERALD_LIMIT="50"
# AVHERALD_MAX_PAGES="3"

# --- what to fetch ---
# update | occurrence
AVHERALD_SORT="update"
# Comma-separated: crash, accident, incident, news, report (empty = all)
# AVHERALD_CATEGORIES="incident,accident"

# --- crawl behaviour ---
# Continue from the last saved list page (true/false). Default true.
AVHERALD_RESUME="true"
# Ignore the saved position and start from the first list page.
AVHERALD_FRESH="false"
AVHERALD_DRY_RUN="false"
AVHERALD_VERBOSE="false"

# --- network ---
REQUEST_DELAY_SECONDS="3"
AVHERALD_TIMEOUT="20"
# If avherald.com blocks this IP:
# HTTPS_PROXY="http://127.0.0.1:8080"
